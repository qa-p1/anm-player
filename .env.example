COMPOSE_PROJECT_NAME=aura

# Frontend
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_ACCESS_TOKEN=replace-with-a-long-random-token

# Backend
API_PORT=8000
API_ENV=development
API_CORS_ORIGINS=http://localhost:5173
API_ACCESS_TOKEN=replace-with-a-long-random-token
AURA_DATA_ROOT=/data
AURA_STATE_FILE=/aura-state/storage-state.json
DOWNLOAD_OVERWRITE_EXISTING=false
DOWNLOAD_AUDIO_FORMAT=mp3
