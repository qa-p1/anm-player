COMPOSE_PROJECT_NAME=anm-player

# Production web binding. Keep this on loopback unless ANM Player is behind a trusted
# authenticated reverse proxy or VPN.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=5173

# Backend boot configuration.
API_ENV=production
API_ACCESS_TOKEN=
API_TRUSTED_HOSTS=localhost,127.0.0.1
AURA_DATA_ROOT=./data
AURA_STATE_FILE=./.aura/storage-state.json
DOWNLOAD_WORKER_POLL_INTERVAL_SECONDS=1

# Infrastructure safety caps.
STREAM_FETCH_MAX_CONCURRENCY=2
STREAM_MAX_FILE_MB=256
STREAM_CACHE_BUDGET_MB=2048
ARTWORK_MAX_RESPONSE_MB=12
ARTWORK_MAX_PIXELS=40000000
ARTWORK_MAX_CONCURRENCY=4
